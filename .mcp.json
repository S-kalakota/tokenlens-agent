{
  "mcpServers": {
    "tokenlens": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/mcp_server.py"
      ],
      "env": {
        "TOKENLENS_STUB": "${TOKENLENS_STUB:-1}",
        "TOKENLENS_USER_ID": "${TOKENLENS_USER_ID:-mcp-user}",
        "TOKENLENS_PROJECT": "${TOKENLENS_PROJECT:-}"
      }
    }
  }
}
