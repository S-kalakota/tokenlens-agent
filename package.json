{
  "name": "tokenlens-cursor",
  "displayName": "TokenLens for Cursor",
  "description": "Stop submitted Cursor prompts and show one local length-based dollar estimate.",
  "version": "0.2.0",
  "publisher": "tokenlens-local",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/S-kalakota/Cursor_Token_Price_Estimator.git"
  },
  "files": [
    "dist/**",
    ".cursor/hooks/tokenlens-before-submit.cjs",
    "README.md"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "cost",
    "prompt",
    "estimate"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:tokenlens.showActions",
    "onCommand:tokenlens.enableEstimateGate",
    "onCommand:tokenlens.disableEstimateGate",
    "onCommand:tokenlens.clearEstimate"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tokenlens.showActions",
        "title": "Show Actions",
        "category": "TokenLens"
      },
      {
        "command": "tokenlens.enableEstimateGate",
        "title": "Enable Enter-to-Estimate Gate",
        "category": "TokenLens"
      },
      {
        "command": "tokenlens.disableEstimateGate",
        "title": "Disable Enter-to-Estimate Gate",
        "category": "TokenLens"
      },
      {
        "command": "tokenlens.clearEstimate",
        "title": "Clear Last Estimate",
        "category": "TokenLens"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm test && npm run build",
    "package:vsix": "npm run validate && npx --yes @vscode/vsce package --out tokenlens-cursor.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "1.100.0",
    "esbuild": "^0.28.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
