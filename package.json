{
  "name": "tokenlens-cursor",
  "displayName": "TokenLens for Cursor",
  "description": "Show a local live cost estimate while typing in Cursor's native side chat.",
  "version": "0.4.0",
  "publisher": "tokenlens-local",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/S-kalakota/Cursor_Token_Price_Estimator.git"
  },
  "files": [
    "dist/**",
    "native/bin/darwin-arm64/tokenlens-ax-observer",
    "README.md"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "cost",
    "prompt",
    "estimate"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:tokenlens.showActions",
    "onCommand:tokenlens.enableLiveEstimate",
    "onCommand:tokenlens.disableLiveEstimate",
    "onCommand:tokenlens.requestAccessibilityPermission",
    "onCommand:tokenlens.diagnoseLiveDraftDetection"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tokenlens.showActions",
        "title": "Show Actions",
        "category": "TokenLens"
      },
      {
        "command": "tokenlens.enableLiveEstimate",
        "title": "Enable Live Estimate",
        "category": "TokenLens"
      },
      {
        "command": "tokenlens.disableLiveEstimate",
        "title": "Disable Live Estimate",
        "category": "TokenLens"
      },
      {
        "command": "tokenlens.requestAccessibilityPermission",
        "title": "Request Accessibility Permission",
        "category": "TokenLens"
      },
      {
        "command": "tokenlens.diagnoseLiveDraftDetection",
        "title": "Diagnose Live Draft Detection",
        "category": "TokenLens"
      }
    ],
    "configuration": {
      "title": "TokenLens",
      "properties": {
        "tokenlens.liveEstimate.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "ignoreSync": true,
          "description": "App-wide live-estimate switch shared by all Cursor windows. Prefer the TokenLens enable/disable commands so the Accessibility privacy explanation is shown."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "node scripts/build-native.mjs",
    "build:ts": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:native && npm run test:ts",
    "test:native": "native/bin/darwin-arm64/tokenlens-ax-observer --self-test && node scripts/test-native.mjs",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "verify:native": "node scripts/verify-native.mjs",
    "validate": "npm run typecheck && npm run build && npm test && npm run verify:native",
    "vscode:prepublish": "npm run build",
    "package:vsix": "npm run validate && vsce package --no-dependencies --target darwin-arm64 --out tokenlens-cursor-darwin-arm64.vsix && node scripts/verify-vsix.mjs tokenlens-cursor-darwin-arm64.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
