# Fixture mode runs the complete walking skeleton without external services.
TOKENLENS_STUB=1
TOKENLENS_USER_ID=local-user
TOKENLENS_TARGET_MODEL=anthropic/claude-sonnet-4
TOKENLENS_PROJECT=
TOKENLENS_RETAIN_RAW_PROMPTS=0

# Real persistence and retrieval.
MONGODB_URI=
MONGODB_DATABASE=tokenlens
TOKENLENS_EMBEDDING_MODEL=voyage-4-lite

# Real rewrite generation.
OPENROUTER_API_KEY=
TOKENLENS_REASON_CHEAP_MODEL=anthropic/claude-haiku-4.5
TOKENLENS_REASON_STRONG_MODEL=anthropic/claude-sonnet-4
TOKENLENS_REASON_STRONG_UPSIDE_TOKENS=400
TOKENLENS_REASON_MAX_TOKENS=1200
# Optional fixed-model override; leave blank to keep expected-upside routing.
TOKENLENS_REASON_MODEL=

# A development-only fallback when the LightGBM artifact is unavailable.
# Production should replace model/booster.txt with the versioned artifact.
TOKENLENS_MODEL_FALLBACK=

# Claude Code handoff.
CLAUDE_BIN=claude
# The legacy harness process-scopes disabling of this installed pre-send gate.
# Change this if your Claude installation uses a different plugin ID.
TOKENLENS_CLAUDE_GATE_PLUGIN=tokenlens@tokenlens

# Temporary Claude Code hook mode. It displays real suggestions after the first
# Enter, but public Claude Code cannot change the composer: Up + Enter sends
# the original prompt, while a copied/edited suggestion is analyzed as new.
TOKENLENS_NATIVE_HOOK_APPROXIMATION=0
# Set to 1 when testing the suggestion UI on short prompts. Production can
# leave it at 0 so cheap drafts skip the OpenRouter rewrite call.
TOKENLENS_ALWAYS_SUGGEST=0
# Required only when Claude is launched outside this repository.
TOKENLENS_AGENT_ROOT=
